        win_6: win_position_6 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp F>, <&kp Y>; mods = <(MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LCTL | MOD_RCTL)>; };
        win_7: win_position_7 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
