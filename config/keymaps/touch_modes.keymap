        mac_16: mac_position_16 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp U>, <&kp F>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_17: mac_position_17 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp I>, <&kp G>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_18: mac_position_18 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
