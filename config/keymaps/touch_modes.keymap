        win_18: win_position_18 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp D>, <&kp H>; mods = <(MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LCTL | MOD_RCTL)>; };
        win_19: win_position_19 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp H>, <&kp J>; mods = <(MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LCTL | MOD_RCTL)>; };
        win_20: win_position_20 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp T>, <&kp K>; mods = <(MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LCTL | MOD_RCTL)>; };
        win_21: win_position_21 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
