            hold-trigger-key-positions = <LEFT_KEYS>;
            hold-trigger-on-release; };
        win_1: win_position_1 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp Q>; mods = <(MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LCTL | MOD_RCTL)>; };
        win_2: win_position_2 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
