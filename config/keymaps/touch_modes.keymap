        mac_9: mac_position_9 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp R>, <&kp O>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_10: mac_position_10 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp L>, <&kp P>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_14: mac_position_14 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
