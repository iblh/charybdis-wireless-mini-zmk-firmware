        mac_20: mac_position_20 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp T>, <&kp K>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_21: mac_position_21 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp N>, <&kp L>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_22: mac_position_22 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp S>, <&kp SEMI>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_25: mac_position_25 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp Z>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_26: mac_position_26 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
