        mac_5: mac_position_5 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp Y>, <&kp T>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_6: mac_position_6 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp F>, <&kp Y>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_7: mac_position_7 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
