    keymap { compatible = "zmk,keymap";
        mac-dv { display-name = "MAC-DV"; bindings = <
            &kp ESC  &mac_1  &mac_2  &mac_3  &mac_4  &mac_5  &mac_6  &mac_7  &mac_8  &mac_9  &mac_10  &kp BSPC
            &kp TAB  &mac_hrm_13 LGUI A  &mac_hrm_14 LALT 0  &mac_hrm_15 LSHFT 0  &mac_hrm_16 LCTRL 0  &mac_17  &mac_18  &mac_hrm_19 RCTRL 0  &mac_hrm_20 RSHFT 0  &mac_hrm_21 RALT 0  &mac_hrm_22 RGUI 0  &kp ENTER
            &kp LSHFT  &mac_25  &mac_26  &mac_27  &mac_28  &mac_29  &mac_30  &kp M  &mac_32  &mac_33  &mac_34  &kp RSHFT
            &thumb FN ESC  &mkp MB1  &thumb NUM BSPC  &thumb SYM ENTER  &thumb NAV SPACE
        >; };
        win-dv { display-name = "WIN-DV"; bindings = <
            &kp ESC  &win_1  &win_2  &win_3  &win_4  &win_5  &win_6  &win_7  &win_8  &win_9  &win_10  &kp BSPC
            &kp TAB  &win_hrm_13 LCTRL A  &win_hrm_14 LALT 0  &win_hrm_15 LSHFT 0  &win_hrm_16 LGUI 0  &win_17  &win_18  &win_hrm_19 RGUI 0  &win_hrm_20 RSHFT 0  &win_hrm_21 RALT 0  &win_hrm_22 RCTRL 0  &kp ENTER
            &kp LSHFT  &win_25  &win_26  &win_27  &win_28  &win_29  &win_30  &kp M  &win_32  &win_33  &win_34  &kp RSHFT
            &thumb FN ESC  &mkp MB1  &thumb NUM BSPC  &thumb SYM ENTER  &thumb NAV SPACE
        >; };
        game { display-name = "GAME"; bindings = <
            &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
            &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp ENTER
            &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
            &kp LCTRL  &kp LALT  &kp SPACE  &mkp MB1  &mo FN
        >; };
        num { display-name = "NUM"; bindings = <
            &kp ESC  &none  &none  &none  &none  &none  &kp PLUS  &kp N7  &kp N8  &kp N9  &kp STAR  &kp BSPC
            &kp TAB  &none  &kp LALT  &kp LSHFT  &kp LCTRL  &none  &kp MINUS  &kp N4  &kp N5  &kp N6  &kp EQUAL  &kp ENTER
            &kp LSHFT  &none  &none  &none  &none  &none  &kp FSLH  &kp N1  &kp N2  &kp N3  &kp DOT  &kp RSHFT
            &mo FN  &mkp MB1  &trans  &kp N0  &kp SPACE
        >; };
        nav { display-name = "NAV"; bindings = <
            &kp ESC  &edit 3  &edit 2  &edit 0  &edit 1  &edit 4  &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp DEL
            &kp TAB  &edit 5  &kp LALT  &kp LSHFT  &kp LCTRL  &none  &none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp ENTER
            &kp LSHFT  &none  &none  &none  &none  &none  &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp RSHFT
            &mo FN  &mkp MB1  &kp BSPC  &kp ENTER  &trans
        >; };
        sym { display-name = "SYM"; bindings = <
            &kp ESC  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp BSPC
            &kp TAB  &kp GRAVE  &kp LT  &kp GT  &kp EQUAL  &kp UNDER  &kp MINUS  &kp PLUS  &kp LBKT  &kp RBKT  &kp BSLH  &kp ENTER
            &kp LSHFT  &kp TILDE  &kp SQT  &kp DQT  &kp SEMI  &kp COLON  &kp PIPE  &kp FSLH  &kp LBRC  &kp RBRC  &kp QMARK  &kp RSHFT
            &mo FN  &mkp MB1  &kp BSPC  &trans  &kp SPACE
        >; };
        fn { display-name = "FN"; bindings = <
            &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
            &mode MAC  &mode WIN  &mode GAME  &none  &pbl PBL_DEC  &pbl PBL_INC  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
            &kp LSHFT  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp RSHFT
            &trans  &mo SCROLL  &mo SLOW  &mkp MB2  &trans
        >; };
        slow { display-name = "SLOW"; bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans
        >; };
        scroll { display-name = "SCROLL"; bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans
        >; };
    };
};
&scroller { layers = <SCROLL>; };
&slow_pointer { layers = <SLOW>; };
