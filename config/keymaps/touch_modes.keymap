        win_30: win_position_30 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp B>, <&kp N>; mods = <(MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LCTL | MOD_RCTL)>; };
        win_32: win_position_32 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp W>, <&kp COMMA>; mods = <(MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LCTL | MOD_RCTL)>; };
        win_33: win_position_33 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
