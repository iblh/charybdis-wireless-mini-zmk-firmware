        mac_34: mac_position_34 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp Z>, <&kp FSLH>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_hrm_13: mac_home_13 { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>;
            flavor = "balanced"; tapping-term-ms = <280>; quick-tap-ms = <175>; require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release; };
        mac_hrm_14: mac_home_14 { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>;
            flavor = "balanced"; tapping-term-ms = <280>; quick-tap-ms = <175>; require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mac_14>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release; };
        mac_hrm_15: mac_home_15 { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>;
            flavor = "balanced"; tapping-term-ms = <280>; quick-tap-ms = <175>; require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mac_15>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release; };
        mac_hrm_16: mac_home_16 { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>;
            flavor = "balanced"; tapping-term-ms = <280>; quick-tap-ms = <175>; require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mac_16>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
