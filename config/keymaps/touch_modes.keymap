/* Prospector Touch input modes. Layer IDs also used by input_mode.c. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include "keymap_features/prospector_brightness.dtsi"
#define MAC 0
#define WIN 1
#define GAME 2
#define NUM 3
#define NAV 4
#define SYM 5
#define FN 6
#define SLOW 7
#define SCROLL 8
#define LEFT_KEYS 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38
#define RIGHT_KEYS 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40
/ {
    behaviors {
        mode: input_mode { compatible = "zmk,behavior-prospector-input-mode"; #binding-cells = <1>; };
        edit: shortcut { compatible = "zmk,behavior-prospector-shortcut"; #binding-cells = <1>; };
        thumb: thumb_layer { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>;
            flavor = "tap-preferred"; tapping-term-ms = <200>; quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>; };
        mac_1: mac_position_1 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp Q>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_2: mac_position_2 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp W>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
        mac_3: mac_position_3 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp E>; mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; keep-mods = <(MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)>; };
